plot_umaps_with_annotations <- function(
sce,
annotation_summary,
pdf_infix_name,
meta_key = "meta15",
umap_name = "UMAP"
) {
has_score <- "Correlation_Score" %in% colnames(annotation_summary)
dir.create(file.path("OUTPUTS_RAFA", pdf_infix_name), showWarnings = FALSE, recursive = TRUE)
# -----------------------------
# 1. Map cluster-level annotations back to every cell
# -----------------------------
cell_clusters <- as.character(sce[[meta_key]])
ann_df <- annotation_summary
ann_df$Cluster <- as.character(ann_df$Cluster)
cluster_to_label <- setNames(ann_df$Predicted_CellType, ann_df$Cluster)
sce$Predicted_CellType <- cluster_to_label[cell_clusters]
if (has_score) {
cluster_to_score <- setNames(ann_df$Correlation_Score, ann_df$Cluster)
sce$Annotation_Score <- cluster_to_score[cell_clusters]
}
# nice combined label for cluster centroids
if (has_score) {
ann_df$Cluster_Label <- paste0(
ann_df$Cluster, ": ", ann_df$Predicted_CellType,
" (r=", ann_df$Correlation_Score, ")"
)
} else {
ann_df$Cluster_Label <- paste0(
ann_df$Cluster, ": ", ann_df$Predicted_CellType
)
}
cluster_to_clusterlabel <- setNames(ann_df$Cluster_Label, ann_df$Cluster)
sce$Cluster_Annotation_Label <- cluster_to_clusterlabel[cell_clusters]
# -----------------------------
# 2. Build plotting dataframe
# -----------------------------
umap_df <- as.data.frame(reducedDim(sce, umap_name))
colnames(umap_df)[1:2] <- c("UMAP1", "UMAP2")
umap_df$Cluster <- as.character(sce[[meta_key]])
umap_df$Predicted_CellType <- sce$Predicted_CellType
umap_df$Cluster_Annotation_Label <- sce$Cluster_Annotation_Label
if ("condition" %in% colnames(colData(sce))) {
umap_df$condition <- sce$condition
}
# centroids for labels
centroid_df <- umap_df %>%
group_by(Cluster, Predicted_CellType, Cluster_Annotation_Label) %>%
summarise(
UMAP1 = median(UMAP1, na.rm = TRUE),
UMAP2 = median(UMAP2, na.rm = TRUE),
.groups = "drop"
)
# -----------------------------
# 3. Plot and save
# -----------------------------
pdf(file.path("OUTPUTS_RAFA", pdf_infix_name,
paste0("annotated_umaps_", meta_key, "_", pdf_infix_name, ".pdf")),
width = 10, height = 8)
# A. UMAP colored by predicted cell type
p1 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.7) +
theme_classic() +
labs(
title = paste0("UMAP colored by predicted annotation - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p1)
# B. UMAP with centroid text labels
p2 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.5) +
geom_text(
data = centroid_df,
aes(x = UMAP1, y = UMAP2, label = Cluster_Annotation_Label),
inherit.aes = FALSE,
size = 3,
fontface = "bold",
check_overlap = TRUE
) +
theme_classic() +
labs(
title = paste0("UMAP with cluster annotation labels - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p2)
# C. Facet by condition if available
if ("condition" %in% colnames(umap_df)) {
p3 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.7) +
facet_wrap(~condition) +
theme_classic() +
labs(
title = paste0("UMAP by condition with predicted annotation - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p3)
}
dev.off()
return(sce)
}
sce_global <- plot_umaps_with_annotations(sce_global, global_annotations, "global")
plot_umaps_with_annotations <- function(
sce,
annotation_summary,
pdf_infix_name,
meta_key = "meta15",
umap_name = "UMAP"
) {
if (!umap_name %in% reducedDimNames(sce)) {
stop(paste0("ReducedDim '", umap_name, "' not found in sce."))
}
if (!meta_key %in% colnames(colData(sce))) {
stop(paste0("Column '", meta_key, "' not found in colData(sce)."))
}
needed_cols <- c("Cluster", "Predicted_CellType")
if (!all(needed_cols %in% colnames(annotation_summary))) {
stop("annotation_summary must contain columns: Cluster, Predicted_CellType")
}
has_score <- "Correlation_Score" %in% colnames(annotation_summary)
dir.create(file.path("OUTPUTS_RAFA", pdf_infix_name), showWarnings = FALSE, recursive = TRUE)
# pull cell-level metacluster IDs safely
cell_clusters <- as.character(colData(sce)[[meta_key]])
ann_df <- annotation_summary
ann_df$Cluster <- as.character(ann_df$Cluster)
# check overlap
if (!any(cell_clusters %in% ann_df$Cluster)) {
stop("No overlap between sce cluster IDs and annotation_summary$Cluster")
}
cluster_to_label <- setNames(ann_df$Predicted_CellType, ann_df$Cluster)
pred_labels <- unname(cluster_to_label[cell_clusters])
sce$Predicted_CellType <- pred_labels
if (has_score) {
cluster_to_score <- setNames(ann_df$Correlation_Score, ann_df$Cluster)
sce$Annotation_Score <- unname(cluster_to_score[cell_clusters])
}
if (has_score) {
ann_df$Cluster_Label <- paste0(
ann_df$Cluster, ": ", ann_df$Predicted_CellType,
" (r=", ann_df$Correlation_Score, ")"
)
} else {
ann_df$Cluster_Label <- paste0(
ann_df$Cluster, ": ", ann_df$Predicted_CellType
)
}
cluster_to_clusterlabel <- setNames(ann_df$Cluster_Label, ann_df$Cluster)
sce$Cluster_Annotation_Label <- unname(cluster_to_clusterlabel[cell_clusters])
umap_df <- as.data.frame(reducedDim(sce, umap_name))
colnames(umap_df)[1:2] <- c("UMAP1", "UMAP2")
umap_df$Cluster <- cell_clusters
umap_df$Predicted_CellType <- sce$Predicted_CellType
umap_df$Cluster_Annotation_Label <- sce$Cluster_Annotation_Label
if ("condition" %in% colnames(colData(sce))) {
umap_df$condition <- sce$condition
}
centroid_df <- umap_df %>%
group_by(Cluster, Predicted_CellType, Cluster_Annotation_Label) %>%
summarise(
UMAP1 = median(UMAP1, na.rm = TRUE),
UMAP2 = median(UMAP2, na.rm = TRUE),
.groups = "drop"
)
pdf(file.path("OUTPUTS_RAFA", pdf_infix_name,
paste0("annotated_umaps_", meta_key, "_", pdf_infix_name, ".pdf")),
width = 10, height = 8)
p1 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.7) +
theme_classic() +
labs(
title = paste0("UMAP colored by predicted annotation - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p1)
p2 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.5) +
geom_text(
data = centroid_df,
aes(x = UMAP1, y = UMAP2, label = Cluster_Annotation_Label),
inherit.aes = FALSE,
size = 3,
fontface = "bold",
check_overlap = TRUE
) +
theme_classic() +
labs(
title = paste0("UMAP with cluster annotation labels - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p2)
if ("condition" %in% colnames(umap_df)) {
p3 <- ggplot(umap_df, aes(x = UMAP1, y = UMAP2, color = Predicted_CellType)) +
geom_point(size = 0.3, alpha = 0.7) +
facet_wrap(~condition) +
theme_classic() +
labs(
title = paste0("UMAP by condition with predicted annotation - ", pdf_infix_name),
color = "Predicted\ncell type"
)
print(p3)
}
dev.off()
return(sce)
}
global_annotations <- automate_annotation(sce_global, "global")
sce_global <- plot_umaps_with_annotations(sce_global, global_annotations, "global")
