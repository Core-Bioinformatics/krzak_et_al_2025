colnames(cluster_medians) <- rownames(expr_mat)
cat("Converting to quantiles (0 to 1 scale)...\n")
# Convert medians to empirical quantiles per marker
cluster_quantiles <- apply(cluster_medians, 2, function(x) ecdf(x)(x))
rownames(cluster_quantiles) <- levels(cluster_ids)
cat("Calculating similarity scores...\n")
score_matrix <- matrix(0, nrow = nrow(cluster_quantiles), ncol = nrow(ref_profile))
rownames(score_matrix) <- rownames(cluster_quantiles)
colnames(score_matrix) <- rownames(ref_profile)
# Calculate distance/similarity ignoring NAs
for (cluster_idx in 1:nrow(cluster_quantiles)) {
for (ref_idx in 1:nrow(ref_profile)) {
# Get the actual and expected profiles
actual <- cluster_quantiles[cluster_idx, ]
expected <- ref_profile[ref_idx, ]
# Only look at markers defined in the reference table (ignore NAs)
valid_markers <- intersect(names(actual), names(expected)[!is.na(expected)])
if (length(valid_markers) > 0) {
vec_actual <- as.numeric(actual[valid_markers])
vec_expected <- as.numeric(expected[valid_markers])
# Calculate Pearson correlation
cor_score <- cor(vec_actual + rnorm(length(vec_actual), 0, 1e-6),
vec_expected + rnorm(length(vec_expected), 0, 1e-6))
score_matrix[cluster_idx, ref_idx] <- cor_score
}
}
}
# Find the best matching cell type for each cluster
best_matches <- apply(score_matrix, 1, function(row) {
colnames(score_matrix)[which.max(row)]
})
annotation_summary <- data.frame(
Cluster = rownames(score_matrix),
Predicted_CellType = best_matches,
Correlation_Score = round(apply(score_matrix, 1, max), 3)
)
print(annotation_summary)
pdf(paste0("OUTPUTS_RAFA/", pdf_infix_name,"/annotated_heatmap_", meta_key, "_", pdf_infix_name,".pdf"), width = 8, height = 6)
pheatmap::pheatmap(score_matrix,
display_numbers = TRUE,
main = "Cluster vs. Reference Profile Similarity")
dev.off()
return(annotation_summary)
}
global_annotations <- automate_annotation(sce_global, "global")
